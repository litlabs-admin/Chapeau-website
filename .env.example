# Resend API key — used by app/api/contact/route.ts to send contact-form
# enquiries. Get one at https://resend.com after creating an account.
RESEND_API_KEY=

# Google reCAPTCHA v2 (checkbox) — used by the contact form to block spam.
# Get a site key + secret key at https://www.google.com/recaptcha/admin.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
